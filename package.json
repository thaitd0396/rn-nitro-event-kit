{
  "name": "rn-nitro-event-kit",
  "version": "1.0.1",
  "description": "Nitro EventKit for React Native: read Apple Calendar events and Apple Reminders on iOS",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md",
    "License.md"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib nitrogen/generated",
    "specs": "nitrogen --logLevel=\"debug\"",
    "codegen": "npm run specs && npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "eventkit",
    "calendar",
    "reminders",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaitd0396/rn-nitro-event-kit.git"
  },
  "author": "Habitify <thaitd0396@gmail.com> (https://github.com/thaitd0396)",
  "contributors": [
    "Vlad Martynov (https://github.com/VladyslavMartynov10)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thaitd0396/rn-nitro-event-kit/issues"
  },
  "homepage": "https://github.com/thaitd0396/rn-nitro-event-kit",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@types/react": "^19.0.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "nitrogen": "0.35.10",
    "prettier": "^3.4.2",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-builder-bob": "^0.37.0",
    "react-native-nitro-modules": "0.35.10",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
