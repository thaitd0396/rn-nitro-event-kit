{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["eventkitx"],
  "ios": {
    "iosModuleName": "NitroEventKitX"
  },
  "android": {
    "androidNamespace": ["eventkitx"],
    "androidCxxLibName": "NitroEventKitX"
  },
  "autolinking": {
    "EventKit": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridEventKit"
      }
    },
    "CalendarPermission": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCalendarPermission"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
